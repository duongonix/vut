fn main():
  items = @[1, 2, 3]
  b = items
  b.push(43)

  out(items)
  out(b)

  items.reserve(8)
  items.push(4)
  items.set(1, 20)
  items.insert(2, 30)

  removed = items.remove(0)
  sliced = items.slice(1, 3)

  out("len: $(items.len())")
  out("capacity: $(items.capacity())")
  out("first after mutation: $(items.at(0))")
  out("removed: $removed")
  out("slice len: $(sliced.len())")
  out("contains 20: $(items.contains(20))")

  items.clear()
  out("empty after clear: $(items.is_empty())")
