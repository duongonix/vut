import env

fn main():
  key = "VUT_EXAMPLE_ENV"
  value = "hello"

  match env.set(key, value):
    ok(written): out("set ok")
    err(error): out("set error")

  out("has: $(env.has(key))")

  # `env.get` returns `result[str?, EnvError]`; optional unwrapping is not
  # available yet, so only success/failure is reported here.
  match env.get(key):
    ok(entry): out("get ok")
    err(error): out("get error")

  match env.remove(key):
    ok(removed): out("remove ok")
    err(error): out("remove error")

  out("has after remove: $(env.has(key))")

  match env.all():
    ok(entries): out("environment entries: $(entries.len())")
    err(error): out("all error")

  arguments = env.args()
  out("arguments: $(arguments.len())")
  # `env.arg(i)` returns `str?`; optional unwrapping is not available yet.
