# Receiver Functions: a typed, statically resolved DSL.

data AppScope:
  title: str
  lists: list[str]

data ColumnScope:
  label: str
  lists: list[str]

fn AppScope.Column(body: fn(ColumnScope)() -> void) -> void:
  scope = ColumnScope(
    label: "column",
    lists: self.lists
  )

  out("column: $(scope.label)")
  body.call(scope)

fn ColumnScope.Button(text: str) -> void:
  self.lists.push("button")
  out("button=$text")

fn App(body: fn(AppScope)() -> void) -> void:
  scope = AppScope(
    title: "app",
    lists: @[]
  )

  body.call(scope)
  out(scope)

fn main():
  App():
    Column():
      Button("Save")
      Button("Cancel")