# Advanced JSON: dynamic values, typed encode, and typed decode.
#
# - dynamic: `json.parse` -> `json.Value`, checked accessors, stringify/pretty.
# - typed encode: a `to_json()` method plus `json.encode` (structural `Encodable`).
# - typed decode: a static `from_json` plus `json.decode` (structural `Decodable`).
import json
import json at Value, Error

data User:
  name: str
  age: int

# --- typed decode -----------------------------------------------------------

fn read_str(value: Value, key: str) -> result[str, Error]:
  match value.get(key):
    ok(field): field.as_str()
    err(error): err(error)

fn read_int(value: Value, key: str) -> result[int, Error]:
  match value.get(key):
    ok(field): field.as_int()
    err(error): err(error)

fn build_user(name: str, value: Value) -> result[User, Error]:
  age_result = read_int(value, "age")
  match age_result:
    ok(age): ok(User(name: name, age: age))
    err(error): err(error)

static fn User.from_json(value: Value) -> result[User, Error]:
  name_result = read_str(value, "name")
  match name_result:
    ok(name): build_user(name, value)
    err(error): err(error)

# --- typed encode -----------------------------------------------------------

fn User.to_json() -> Value:
  entries: map[str, Value] = ()
  entries.set("name", json.value_str(value = self.name))
  entries.set("age", json.value_int(value = self.age))
  json.value_object(value = entries)

# --- dynamic access ---------------------------------------------------------

fn print_tags(value: Value):
  match value.as_array():
    ok(items): out("tags: $(items.len())")
    err(error): out("tags: <not an array>")

fn inspect_value(value: Value):
  is_object = value.is_object()
  out("parsed object: $is_object")
  match value.get("tags"):
    ok(tags): print_tags(tags)
    err(error): out("tags: <missing>")
  out("compact: $(json.stringify(value))")
  out("pretty:")
  out(json.stringify_pretty(value))

fn inspect(source: str):
  match json.parse(source):
    ok(value): inspect_value(value)
    err(error): out("parse error at $(error.line):$(error.column): $(error.message)")

fn decode_user(source: str):
  parsed: result[User, Error] = json.decode(source)
  match parsed:
    ok(user): out("decoded: $(user.name), $(user.age)")
    err(error): out("decode error: $(error.message)")

fn main():
  inspect("{\"name\":\"Vut\",\"tags\":[\"fast\",\"typed\"]}")

  decode_user("{\"name\":\"Nam\",\"age\":20}")
  decode_user("{\"name\":\"Nam\"}")

  user = User(name: "Linh", age: 30)
  out("encoded: $(json.encode(user))")

  pretty_user = User(name: "Mai", age: 25)
  out("encoded pretty:")
  out(json.encode_pretty(pretty_user))
