# `array[T,N]` — every built-in method.
#
# `array[T,N]` is fixed-size and stored inline; it never grows. `@[...]` builds
# a `list[T]` instead. Out-of-range indexing traps at runtime.

fn main():
  fixed = [3, 1, 2]
  out("len:", fixed.len())
  out("at(0):", fixed.at(0))

  fixed.set(0, 9)
  out("after_set:", fixed)

  out("first:", fixed.first(), "last:", fixed.last())
  out("contains(2):", fixed.contains(2), "contains(99):", fixed.contains(99))

  fixed.reverse()
  out("reversed:", fixed)

  fixed.sort()
  out("sorted:", fixed)

  # `to_list` produces an independent growable copy.
  items = fixed.to_list()
  items.push(4)
  out("list:", items)
  out("array_unchanged:", fixed)

  zeros = [0, 0, 0]
  zeros.fill(7)
  out("filled:", zeros)

  for value, index in fixed:
    out("item $index = $value")
