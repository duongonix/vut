# A small Vut program exercising functions, data, methods, lists, loops,
# and both forms of template interpolation.

data Counter:
  value: int

fn Counter.get() -> int:
  self.value

fn double(value: int) -> int:
  value * 2

fn main():
  counter = Counter(value: 21)
  values: list[int] = @[10, 20, 30]

  out("Welcome to Vut!")
  for value, index in values:
    out("item $index = $value")

  out("The answer is $(double(counter.get()))")
