# Storing and invoking a receiver function value with `.call(receiver, ...args)`.
#
# A trailing receiver body produces a receiver-function value. It can be
# returned, stored, and invoked later; the receiver is always the first
# argument to `.call`, and it is borrowed (not moved).

data FormScope:
  label: str

fn capture(body: fn(FormScope)(str) -> bool) -> fn(FormScope)(str) -> bool:
  body

fn FormScope.Field(name: str) -> bool:
  out("field=$name")
  name != ""

fn main():
  scope = FormScope(label: "signup")
  submit = capture() (name):
    Field(name)

  accepted = submit.call(scope, "email")
  if accepted:
    out("accepted yes")
  else:
    out("accepted no")

  rejected = submit.call(scope, "")
  if rejected:
    out("rejected yes")
  else:
    out("rejected no")
